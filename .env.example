# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# LLM provider: anthropic | openai | mock   (mock = offline heuristic, NOT an LLM, $0)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=claude-haiku-4-5
# USD per million tokens -- set to your provider's current list price so cost reporting is accurate
LLM_PRICE_IN_PER_MTOK=1.00
LLM_PRICE_OUT_PER_MTOK=5.00
LLM_MAX_INPUT_CHARS=6000
# Hard stop per run (assignment reimburses up to $20)
LLM_BUDGET_USD=5

# Identify yourself to the sites you scrape
USER_AGENT=job-intel-takehome/1.0 (+mailto:you@example.com)
MIN_INTERVAL_S=1.0
HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=4

# Sources (defaults match the assignment)
GREENHOUSE_TOKENS=stripe,airbnb,databricks,figma
GREENHOUSE_FALLBACK_TOKENS=dropbox,datadog,robinhood
LEVER_SITES=palantir,plaid
LEVER_FALLBACK_SITES=spotify,netflix
# Set only if thread discovery is blocked (e.g. robots.txt disallows /submitted)
HN_THREAD_ID=

# DATA_DIR=./data
# LOG_DIR=./logs
